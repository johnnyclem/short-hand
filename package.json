{
  "name": "@shorthand/core",
  "version": "0.1.0",
  "description": "Progressive context compaction for LLMs: LSM-style compaction, CRDT agent memory, importance detection, and truth-ledger interop. Old computer science for new constraints.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compaction": {
      "types": "./dist/compaction/index.d.ts",
      "import": "./dist/compaction/index.js"
    },
    "./crdt": {
      "types": "./dist/crdt/index.d.ts",
      "import": "./dist/crdt/index.js"
    },
    "./importance": {
      "types": "./dist/importance/index.d.ts",
      "import": "./dist/importance/index.js"
    },
    "./truth": {
      "types": "./dist/truth/index.d.ts",
      "import": "./dist/truth/index.js"
    },
    "./wiki": {
      "types": "./dist/wiki/index.d.ts",
      "import": "./dist/wiki/index.js"
    },
    "./ingestion": {
      "types": "./dist/ingestion/index.d.ts",
      "import": "./dist/ingestion/index.js"
    },
    "./interpreter": {
      "types": "./dist/interpreter/index.d.ts",
      "import": "./dist/interpreter/index.js"
    },
    "./verification": {
      "types": "./dist/verification/index.d.ts",
      "import": "./dist/verification/index.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark/index.d.ts",
      "import": "./dist/benchmark/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "benchmark": "npm run build && node dist/benchmark/run.js",
    "benchmark:live": "npm run build && node dist/benchmark/run.js --live",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "context",
    "compaction",
    "lsm-tree",
    "crdt",
    "conversation",
    "memory",
    "progressive",
    "context-compaction",
    "token",
    "summarization",
    "agent-memory",
    "importance-detection",
    "truth-ledger"
  ],
  "author": "Johnny Clem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnnyclem/short-hand.git"
  },
  "bugs": {
    "url": "https://github.com/johnnyclem/short-hand/issues"
  },
  "homepage": "https://github.com/johnnyclem/short-hand#readme",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "20.19.39",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
